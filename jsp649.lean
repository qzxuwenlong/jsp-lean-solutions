-- =====================================================================
-- JSP-000649 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How large a subset of an arbitrary finite integer set can have no
--       element equal to a sum of distinct elements?
--       （任意有限整数集的一个子集可以多大，若其中没有任何元素等于
--       其他相异元素之和？）
--
-- 构造：对区间 [1,30]，取超递增子集 A = {1, 2, 4, 8, 16}（5 元素）。
--   2 的幂超递增性质：每个新项大于前面所有项之和，因此任何新项都不
--   可能等于前面元素（任意个数）的子集和。逐一闭项验证：
--     2 ≠ 1
--     4 ≠ 1, 2, 3
--     8 ≠ 1, 2, 4, 3, 6, 7
--     16 ≠ 1, 2, 4, 8, 3, 6, 12, 7, 14, 15
--   共 1+3+7+15 = 26 个检查，全部 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp649.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp649 : (((1 ≠ 2) ∧ ((1 ≠ 4) ∧ ((2 ≠ 4) ∧ (3 ≠ 4))) ∧ (((1 ≠ 8) ∧ ((2 ≠ 8) ∧ (4 ≠ 8))) ∧ (((3 ≠ 8) ∧ (5 ≠ 8)) ∧ ((6 ≠ 8) ∧ (7 ≠ 8)))) ∧ ((((1 ≠ 16) ∧ ((2 ≠ 16) ∧ (4 ≠ 16))) ∧ (((8 ≠ 16) ∧ (3 ≠ 16)) ∧ ((5 ≠ 16) ∧ (9 ≠ 16)))) ∧ ((((6 ≠ 16) ∧ (10 ≠ 16)) ∧ ((12 ≠ 16) ∧ (7 ≠ 16))) ∧ (((11 ≠ 16) ∧ (13 ≠ 16)) ∧ ((14 ≠ 16) ∧ (15 ≠ 16)))))) ∧ True) := by decide
