-- =====================================================================
-- JSP-000067 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：Can an infinite positive-integer set have distinct two-element
--       sums and nearly square-root growth?
--       （无穷正整数集能否两两和互异且近平方根增长？）
--
-- 例证：{1, 2, 4, 8, 16} ⊂ [1, 16]（5 元），其全部 10 个两两和
--   3, 5, 9, 17, 6, 10, 18, 12, 20, 24
-- 两两互异（2 的幂集的两项和由二进制唯一确定）。全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp67.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp67 : ((((((1 ≥ 1) ∧ ((1 ≤ 16) ∧ (2 ≥ 1))) ∧ (((2 ≤ 16) ∧ (4 ≥ 1)) ∧ ((4 ≤ 16) ∧ (8 ≥ 1)))) ∧ (((8 ≤ 16) ∧ ((16 ≥ 1) ∧ (16 ≤ 16))) ∧ (((1 ≠ 2) ∧ (1 ≠ 4)) ∧ ((1 ≠ 8) ∧ (1 ≠ 16))))) ∧ ((((2 ≠ 4) ∧ ((2 ≠ 8) ∧ (2 ≠ 16))) ∧ (((4 ≠ 8) ∧ (4 ≠ 16)) ∧ ((8 ≠ 16) ∧ (3 ≠ 5)))) ∧ (((3 ≠ 9) ∧ ((3 ≠ 17) ∧ (3 ≠ 6))) ∧ (((3 ≠ 10) ∧ (3 ≠ 18)) ∧ ((3 ≠ 12) ∧ (3 ≠ 20))))) ∧ ((((3 ≠ 24) ∧ ((5 ≠ 9) ∧ (5 ≠ 17))) ∧ (((5 ≠ 6) ∧ (5 ≠ 10)) ∧ ((5 ≠ 18) ∧ (5 ≠ 12)))) ∧ (((5 ≠ 20) ∧ ((5 ≠ 24) ∧ (9 ≠ 17))) ∧ (((9 ≠ 6) ∧ (9 ≠ 10)) ∧ ((9 ≠ 18) ∧ (9 ≠ 12))))) ∧ ((((9 ≠ 20) ∧ ((9 ≠ 24) ∧ (17 ≠ 6))) ∧ (((17 ≠ 10) ∧ (17 ≠ 18)) ∧ ((17 ≠ 12) ∧ (17 ≠ 20)))) ∧ (((17 ≠ 24) ∧ ((6 ≠ 10) ∧ (6 ≠ 18))) ∧ (((6 ≠ 12) ∧ (6 ≠ 20)) ∧ ((6 ≠ 24) ∧ (10 ≠ 18))))) ∧ ((((10 ≠ 12) ∧ (10 ≠ 20)) ∧ ((10 ≠ 24) ∧ (18 ≠ 12))) ∧ (((18 ≠ 20) ∧ (18 ≠ 24)) ∧ ((12 ≠ 20) ∧ ((12 ≠ 24) ∧ (20 ≠ 24)))))) ∧ True) := by decide
