-- =====================================================================
-- JSP-000167 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：sparse ruler problem
--       例证：6 标记稀疏尺 {0, 1, 2, 6, 10, 13} 覆盖长度 13 的
--       全部距离 1..13：
--   1 = 1−0、2 = 2−0、3 = 13−10、4 = 6−2、5 = 6−1、6 = 6−0、
--   7 = 13−6、8 = 10−2、9 = 10−1、10 = 10−0、11 = 13−2、
--   12 = 13−1、13 = 13−0。
--       全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp167.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp167 : ((((((0 ≠ 1) ∧ ((0 ≠ 2) ∧ (0 ≠ 6))) ∧ (((0 ≠ 10) ∧ (0 ≠ 13)) ∧ ((1 ≠ 2) ∧ (1 ≠ 6)))) ∧ (((1 ≠ 10) ∧ ((1 ≠ 13) ∧ (2 ≠ 6))) ∧ (((2 ≠ 10) ∧ (2 ≠ 13)) ∧ ((6 ≠ 10) ∧ (6 ≠ 13))))) ∧ ((((10 ≠ 13) ∧ ((0 ≥ 0) ∧ (0 ≤ 13))) ∧ (((1 ≥ 0) ∧ (1 ≤ 13)) ∧ ((2 ≥ 0) ∧ (2 ≤ 13)))) ∧ (((6 ≥ 0) ∧ ((6 ≤ 13) ∧ (10 ≥ 0))) ∧ (((10 ≤ 13) ∧ (13 ≥ 0)) ∧ ((13 ≤ 13) ∧ (1 - 0 = 1))))) ∧ ((((2 - 0 = 2) ∧ ((13 - 10 = 3) ∧ (6 - 2 = 4))) ∧ ((6 - 1 = 5) ∧ ((6 - 0 = 6) ∧ (13 - 6 = 7)))) ∧ (((10 - 2 = 8) ∧ ((10 - 1 = 9) ∧ (10 - 0 = 10))) ∧ ((13 - 2 = 11) ∧ ((13 - 1 = 12) ∧ (13 - 0 = 13)))))) ∧ True) := by decide
