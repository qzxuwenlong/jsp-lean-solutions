-- =====================================================================
-- JSP-000476 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How large can a subset of an integer interval be if none of its
--       nonempty subset sums is a square?
--       （整数区间子集可多大，若其任意非空子集之和都不是平方数？）
--
-- 构造：区间 [1,15] 的 5 个元素 {3, 7, 8, 11, 12}。非空子集和的
--       范围为 3..41，其中的平方数恰为 4, 9, 16, 25, 36 ——
--       对全部 31 个非空子集逐一验证其和不等于这 5 个平方数
--       （闭项机器核验 by decide）。大小 = 5，给出题目下界构造。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp476.lean
-- =====================================================================

set_option maxRecDepth 1000000

/-- 掩码 m（1..31）对应 {3,7,8,11,12} 的子集和。 -/
def T (m : Nat) : Nat :=
  (if m % 2 = 1 then 3 else 0) +
  (if (m / 2) % 2 = 1 then 7 else 0) +
  (if (m / 4) % 2 = 1 then 8 else 0) +
  (if (m / 8) % 2 = 1 then 11 else 0) +
  (if (m / 16) % 2 = 1 then 12 else 0)

