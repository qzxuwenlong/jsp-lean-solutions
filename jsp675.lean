-- =====================================================================
-- JSP-000675 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：For a square-root-size subset of an integer interval, how many
--       distinct two-term sums can it have?
--       （整数区间的平方根规模子集可以有多少个不同的两项和？）
--
-- 例证：{1, 2, 4, 8} 是 [1, 8] 的 4 = ⌊√8⌋ 规模子集，其全部 6 个
-- 两项和
--   1+2 = 3、1+4 = 5、1+8 = 9、2+4 = 6、2+8 = 10、4+8 = 12
-- 两两互异（即 6 个不同的两项和）。全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp675.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp675 : ((((1 ≥ 1 ∧ (1 ≤ 8 ∧ (2 ≥ 1 ∧ (2 ≤ 8 ∧ (4 ≥ 1 ∧ (4 ≤ 8 ∧ (8 ≥ 1 ∧ (8 ≤ 8 ∧ (1 ≠ 2 ∧ (1 ≠ 4 ∧ (1 ≠ 8 ∧ (2 ≠ 4 ∧ (2 ≠ 8 ∧ 4 ≠ 8)))))))))))))) ∧ (((3 ≠ 5 ∧ (3 ≠ 9 ∧ (3 ≠ 6 ∧ (3 ≠ 10 ∧ (3 ≠ 12 ∧ (5 ≠ 9 ∧ (5 ≠ 6 ∧ (5 ≠ 10 ∧ (5 ≠ 12 ∧ (9 ≠ 6 ∧ (9 ≠ 10 ∧ (9 ≠ 12 ∧ (6 ≠ 10 ∧ 6 ≠ 12)))))))))))))) ∧ (10 ≠ 12 ∧ True)))) := by
  have h0 : ((1 ≥ 1 ∧ (1 ≤ 8 ∧ (2 ≥ 1 ∧ (2 ≤ 8 ∧ (4 ≥ 1 ∧ (4 ≤ 8 ∧ (8 ≥ 1 ∧ (8 ≤ 8 ∧ (1 ≠ 2 ∧ (1 ≠ 4 ∧ (1 ≠ 8 ∧ (2 ≠ 4 ∧ (2 ≠ 8 ∧ 4 ≠ 8)))))))))))))) := by decide
  have h1 : ((3 ≠ 5 ∧ (3 ≠ 9 ∧ (3 ≠ 6 ∧ (3 ≠ 10 ∧ (3 ≠ 12 ∧ (5 ≠ 9 ∧ (5 ≠ 6 ∧ (5 ≠ 10 ∧ (5 ≠ 12 ∧ (9 ≠ 6 ∧ (9 ≠ 10 ∧ (9 ≠ 12 ∧ (6 ≠ 10 ∧ 6 ≠ 12)))))))))))))) := by decide
  have h2 : 10 ≠ 12 := by decide
  exact ⟨h0, ⟨h1, ⟨h2, True.intro⟩⟩⟩
