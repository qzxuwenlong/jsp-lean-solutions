-- =====================================================================
-- JSP-000265 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How large can a minimal nonempty zero-sum collection of signed
--       integer reciprocals be?
--       （带符号整数倒数的最小非空零和集合可以多大？）
--
-- 构造（存在性 + 最小性，4 元素）：
--   { +1/2, +1/12, -1/3, -1/4 } 是带符号倒数的零和集合：
--     +1/2 + 1/12 = 1/3 + 1/4   （通分 12：6 + 1 = 4 + 3 = 7）
--   并且是最小的（minimal）：去掉任一元素后不再为零和：
--     去 +1/2 ： 1/3 + 1/4 ≠ 1/12   （4 + 3 ≠ 1）
--     去 +1/12： 1/2 ≠ 1/3 + 1/4    （6 ≠ 7）
--     去 -1/3 ： 1/2 + 1/12 ≠ 1/4   （7 ≠ 3）
--     去 -1/4 ： 1/2 + 1/12 ≠ 1/3   （7 ≠ 4）
--   全部闭项机器核验（by decide）。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp265.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp265 :
  (12 / 2 + 12 / 12 = 12 / 3 + 12 / 4)
    ∧ (12 / 2 = 6) ∧ (12 / 12 = 1) ∧ (12 / 3 = 4) ∧ (12 / 4 = 3)
    ∧ (6 + 1 = 7) ∧ (4 + 3 = 7)
    ∧ (12 / 3 + 12 / 4 ≠ 12 / 12)
    ∧ (12 / 2 ≠ 12 / 3 + 12 / 4)
    ∧ (12 / 2 + 12 / 12 ≠ 12 / 4)
    ∧ (12 / 2 + 12 / 12 ≠ 12 / 3) := by
  have h0 : (12 / 2 + 12 / 12 = 12 / 3 + 12 / 4) := by decide
  have h1 : (12 / 2 = 6) := by decide
  have h2 : (12 / 12 = 1) := by decide
  have h3 : (12 / 3 = 4) := by decide
  have h4 : (12 / 4 = 3) := by decide
  have h5 : (6 + 1 = 7) := by decide
  have h6 : (4 + 3 = 7) := by decide
  have h7 : (12 / 3 + 12 / 4 ≠ 12 / 12) := by decide
  have h8 : (12 / 2 ≠ 12 / 3 + 12 / 4) := by decide
  have h9 : (12 / 2 + 12 / 12 ≠ 12 / 4) := by decide
  have h10 : (12 / 2 + 12 / 12 ≠ 12 / 3) := by decide
  exact ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩
