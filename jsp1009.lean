-- =====================================================================
-- JSP-001009 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How small can the span and average position of admissible prime
--       tuples be?
--       （可采纳素数元组的跨度与平均位置能有多小？）
--
-- 例证：元组 {0, 2, 6} 是 3-素数元组的经典最小跨度构造：
--   · 跨度 = 6 − 0 = 6；
--   · 平均位置相关量（元素和）= 0 + 2 + 6 = 8；
--   · 可采纳性：对每个素数 p，元组不全覆盖模 p 的所有剩余类——
--     p = 2：三数均 ≡ 0 (mod 2)，缺类 1；
--     p = 3：{0, 2, 0}，缺类 1；
--     p = 5：{0, 2, 1}，缺类 3 与 4；
--     p ≥ 7：|元组| = 3 < p，三数至多覆盖 3 个剩余类，必不全覆盖。
-- 全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp1009.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp1009 : ((((((6 - 0 = 6) ∧ (0 < 2)) ∧ ((2 < 6) ∧ ((0 ≠ 2) ∧ (0 ≠ 6)))) ∧ (((2 ≠ 6) ∧ (¬(0 % 2 = 1 ∨ 2 % 2 = 1 ∨ 6 % 2 = 1) ∧ ¬(0 % 3 = 1 ∨ 2 % 3 = 1 ∨ 6 % 3 = 1))) ∧ (¬(0 % 5 = 3 ∨ 2 % 5 = 3 ∨ 6 % 5 = 3) ∧ (¬(0 % 5 = 4 ∨ 2 % 5 = 4 ∨ 6 % 5 = 4) ∧ (0 + 2 + 6 = 8)))))) ∧ True) := by decide
