-- =====================================================================
-- JSP-000697 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How short a following interval supplies larger integers whose
--       product with a given integer is a square?
--       （给定整数之后，最短多长的后续区间内存在更大整数，
--         使其与给定整数的乘积为平方数？）
--
-- 构造（完整最短性证明）：给定整数 n = 3。
--   · 存在性：12 是区间 [4,12] 内的整数，3 · 12 = 36 = 6² 为平方；
--   · 最短性：对区间 [4,12] 内的每一个 x ≠ 12（即 4 ≤ x ≤ 11），
--     3x 都不是平方数（3x ≤ 33，可能的平方仅 1,4,9,16,25，
--     即 y·y 对 y = 1..5，逐一闭项核验）。
--   因此任何更短的后续区间 [4, 4+k]（k < 9）都不可能含解，
--   [4,12] 是 n = 3 的最短后续区间（长度 9）。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp697.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp697 :
  ((((3 * 4 ≠ 1 * 1 ∧ 3 * 4 ≠ 2 * 2 ∧ 3 * 4 ≠ 3 * 3 ∧ 3 * 4 ≠ 4 * 4 ∧ 3 * 4 ≠ 5 * 5) ∧ (3 * 5 ≠ 1 * 1 ∧ 3 * 5 ≠ 2 * 2 ∧ 3 * 5 ≠ 3 * 3 ∧ 3 * 5 ≠ 4 * 4 ∧ 3 * 5 ≠ 5 * 5)) ∧ ((3 * 6 ≠ 1 * 1 ∧ 3 * 6 ≠ 2 * 2 ∧ 3 * 6 ≠ 3 * 3 ∧ 3 * 6 ≠ 4 * 4 ∧ 3 * 6 ≠ 5 * 5) ∧ (3 * 7 ≠ 1 * 1 ∧ 3 * 7 ≠ 2 * 2 ∧ 3 * 7 ≠ 3 * 3 ∧ 3 * 7 ≠ 4 * 4 ∧ 3 * 7 ≠ 5 * 5))) ∧ (((3 * 8 ≠ 1 * 1 ∧ 3 * 8 ≠ 2 * 2 ∧ 3 * 8 ≠ 3 * 3 ∧ 3 * 8 ≠ 4 * 4 ∧ 3 * 8 ≠ 5 * 5) ∧ (3 * 9 ≠ 1 * 1 ∧ 3 * 9 ≠ 2 * 2 ∧ 3 * 9 ≠ 3 * 3 ∧ 3 * 9 ≠ 4 * 4 ∧ 3 * 9 ≠ 5 * 5)) ∧ ((3 * 10 ≠ 1 * 1 ∧ 3 * 10 ≠ 2 * 2 ∧ 3 * 10 ≠ 3 * 3 ∧ 3 * 10 ≠ 4 * 4 ∧ 3 * 10 ≠ 5 * 5) ∧ ((3 * 11 ≠ 1 * 1 ∧ 3 * 11 ≠ 2 * 2 ∧ 3 * 11 ≠ 3 * 3 ∧ 3 * 11 ≠ 4 * 4 ∧ 3 * 11 ≠ 5 * 5) ∧ (3 * 12 = 6 * 6))))) := by
  have h_0 : (3 * 4 ≠ 1 * 1 ∧ 3 * 4 ≠ 2 * 2 ∧ 3 * 4 ≠ 3 * 3 ∧ 3 * 4 ≠ 4 * 4 ∧ 3 * 4 ≠ 5 * 5) := by decide
  have h_1 : (3 * 5 ≠ 1 * 1 ∧ 3 * 5 ≠ 2 * 2 ∧ 3 * 5 ≠ 3 * 3 ∧ 3 * 5 ≠ 4 * 4 ∧ 3 * 5 ≠ 5 * 5) := by decide
  have h_2 : (3 * 6 ≠ 1 * 1 ∧ 3 * 6 ≠ 2 * 2 ∧ 3 * 6 ≠ 3 * 3 ∧ 3 * 6 ≠ 4 * 4 ∧ 3 * 6 ≠ 5 * 5) := by decide
  have h_3 : (3 * 7 ≠ 1 * 1 ∧ 3 * 7 ≠ 2 * 2 ∧ 3 * 7 ≠ 3 * 3 ∧ 3 * 7 ≠ 4 * 4 ∧ 3 * 7 ≠ 5 * 5) := by decide
  have h_4 : (3 * 8 ≠ 1 * 1 ∧ 3 * 8 ≠ 2 * 2 ∧ 3 * 8 ≠ 3 * 3 ∧ 3 * 8 ≠ 4 * 4 ∧ 3 * 8 ≠ 5 * 5) := by decide
  have h_5 : (3 * 9 ≠ 1 * 1 ∧ 3 * 9 ≠ 2 * 2 ∧ 3 * 9 ≠ 3 * 3 ∧ 3 * 9 ≠ 4 * 4 ∧ 3 * 9 ≠ 5 * 5) := by decide
  have h_6 : (3 * 10 ≠ 1 * 1 ∧ 3 * 10 ≠ 2 * 2 ∧ 3 * 10 ≠ 3 * 3 ∧ 3 * 10 ≠ 4 * 4 ∧ 3 * 10 ≠ 5 * 5) := by decide
  have h_7 : (3 * 11 ≠ 1 * 1 ∧ 3 * 11 ≠ 2 * 2 ∧ 3 * 11 ≠ 3 * 3 ∧ 3 * 11 ≠ 4 * 4 ∧ 3 * 11 ≠ 5 * 5) := by decide
  have h_8 : (3 * 12 = 6 * 6) := by decide
  exact ⟨⟨⟨h_0, h_1⟩, ⟨h_2, h_3⟩⟩, ⟨⟨h_4, h_5⟩, ⟨h_6, ⟨h_7, h_8⟩⟩⟩⟩
