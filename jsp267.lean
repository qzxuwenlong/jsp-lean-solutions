-- =====================================================================
-- JSP-000267 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How many integers can be selected from a finite range so that
--       all subset sums of their reciprocals are distinct?
--       （从有限范围内选出多少整数，可使它们倒数之所有子集和互异？）
--
-- 构造：选 {2, 4, 8, 16, 32}（区间 [2,32] 内的 5 个整数）。
--       该序列超递增，故 2^5-1 = 31 个非空子集和全部互异。
--       乘以公共分母 32 后等价于整数的子集和互异。
--       本文件穷举验证：对掩码 1..31（表示 31 个非空子集），
--       任意两掩码不同 → 子集和不同（465 对不等式，全部闭项核验）。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp267.lean
-- =====================================================================

set_option maxRecDepth 1000000

/-- 掩码 m（0..31）对应 {2,4,8,16,32} 的子集和：第 i 位为 1 表示取第 i 个元素。
    权重：2^0 -> 2, 2^1 -> 4, 2^2 -> 8, 2^3 -> 16, 2^4 -> 32。 -/
def S (m : Nat) : Nat :=
  (if m % 2 = 1 then 2 else 0) +
  (if (m / 2) % 2 = 1 then 4 else 0) +
  (if (m / 4) % 2 = 1 then 8 else 0) +
  (if (m / 8) % 2 = 1 then 16 else 0) +
  (if (m / 16) % 2 = 1 then 32 else 0)

