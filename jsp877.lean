-- =====================================================================
-- JSP-000877 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：Carmichael numbers（卡迈克尔数）
--
-- 例证：561 = 3·11·17 是卡迈克尔数。
--   · 561 为合数（3·11·17 = 561，且 3 是非平凡真因子）；
--   · 素因子 3、11、17 两两互异，且均无小于自身平方根的真因子
--     （3<2² 且 3%2≠0；11<12² 检查 2,3,5,7；17 检查 2,3,5,7,11,13）；
--   · 平方自由：p² 不整除 561（对 p ∈ {3,11,17}）；
--   · Korselt 条件：(561-1) % (p-1) = 0，即 560 分别被 2、10、16
--     整除；
--   · 无其他素因子：561 % d ≠ 0（d ∈ {2,5,7,13,19}），且 561 < 23²，
--     故素因子恰为 {3,11,17}。
-- 由 Korselt 准则，561 对所有与它互素的底 a 满足 a^(560) ≡ 1 (mod 561)，
-- 即为卡迈克尔数。
--   全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp877.lean
-- =====================================================================

set_option maxRecDepth 1000000

def R0 : Prop := ((((((3 * 11 * 17 = 561) ∧ (3 % 2 ≠ 0)) ∧ ((11 % 2 ≠ 0) ∧ (11 % 3 ≠ 0))) ∧ (((11 % 5 ≠ 0) ∧ (11 % 7 ≠ 0)) ∧ ((17 % 2 ≠ 0) ∧ (17 % 3 ≠ 0)))) ∧ ((((17 % 5 ≠ 0) ∧ (17 % 7 ≠ 0)) ∧ ((17 % 11 ≠ 0) ∧ (17 % 13 ≠ 0))) ∧ (((3 ≠ 11) ∧ (3 ≠ 17)) ∧ ((11 ≠ 17) ∧ (561 % (3 * 3) ≠ 0))))) ∧ (((((561 % (11 * 11) ≠ 0) ∧ (561 % (17 * 17) ≠ 0)) ∧ ((560 % 2 = 0) ∧ (560 % 10 = 0))) ∧ (((560 % 16 = 0) ∧ (561 % 3 = 0)) ∧ ((561 % 11 = 0) ∧ (561 % 17 = 0)))) ∧ ((((561 % 2 ≠ 0) ∧ (561 % 5 ≠ 0)) ∧ ((561 % 7 ≠ 0) ∧ (561 % 13 ≠ 0))) ∧ (((561 % 19 ≠ 0) ∧ (561 % 3 = 0)) ∧ ((3 ≠ 1) ∧ (3 ≠ 561))))))

theorem jsp877 : R0 := by

  have h_0 : (3 * 11 * 17 = 561) := by decide
  have h_1 : (3 % 2 ≠ 0) := by decide
  have h_2 : (11 % 2 ≠ 0) := by decide
  have h_3 : (11 % 3 ≠ 0) := by decide
  have h_4 : (11 % 5 ≠ 0) := by decide
  have h_5 : (11 % 7 ≠ 0) := by decide
  have h_6 : (17 % 2 ≠ 0) := by decide
  have h_7 : (17 % 3 ≠ 0) := by decide
  have h_8 : (17 % 5 ≠ 0) := by decide
  have h_9 : (17 % 7 ≠ 0) := by decide
  have h_10 : (17 % 11 ≠ 0) := by decide
  have h_11 : (17 % 13 ≠ 0) := by decide
  have h_12 : (3 ≠ 11) := by decide
  have h_13 : (3 ≠ 17) := by decide
  have h_14 : (11 ≠ 17) := by decide
  have h_15 : (561 % (3 * 3) ≠ 0) := by decide
  have h_16 : (561 % (11 * 11) ≠ 0) := by decide
  have h_17 : (561 % (17 * 17) ≠ 0) := by decide
  have h_18 : (560 % 2 = 0) := by decide
  have h_19 : (560 % 10 = 0) := by decide
  have h_20 : (560 % 16 = 0) := by decide
  have h_21 : (561 % 3 = 0) := by decide
  have h_22 : (561 % 11 = 0) := by decide
  have h_23 : (561 % 17 = 0) := by decide
  have h_24 : (561 % 2 ≠ 0) := by decide
  have h_25 : (561 % 5 ≠ 0) := by decide
  have h_26 : (561 % 7 ≠ 0) := by decide
  have h_27 : (561 % 13 ≠ 0) := by decide
  have h_28 : (561 % 19 ≠ 0) := by decide
  have h_29 : (561 % 3 = 0) := by decide
  have h_30 : (3 ≠ 1) := by decide
  have h_31 : (3 ≠ 561) := by decide
  exact ⟨⟨⟨⟨⟨h_0, h_1⟩, ⟨h_2, h_3⟩⟩, ⟨⟨h_4, h_5⟩, ⟨h_6, h_7⟩⟩⟩, ⟨⟨⟨h_8, h_9⟩, ⟨h_10, h_11⟩⟩, ⟨⟨h_12, h_13⟩, ⟨h_14, h_15⟩⟩⟩⟩, ⟨⟨⟨⟨h_16, h_17⟩, ⟨h_18, h_19⟩⟩, ⟨⟨h_20, h_21⟩, ⟨h_22, h_23⟩⟩⟩, ⟨⟨⟨h_24, h_25⟩, ⟨h_26, h_27⟩⟩, ⟨⟨h_28, h_29⟩, ⟨h_30, h_31⟩⟩⟩⟩⟩
