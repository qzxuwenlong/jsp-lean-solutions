-- =====================================================================
-- JSP-000297 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：segmented numbers
-- 描述：从给定整数起，反复并入不能表示为连续较早项之和的最小整数；
--       判定其密度与增长（超线性但低于任意固定超线性幂）。
--
-- 例证：从 1 开始的 segmented 序列前四项为 1, 2, 4, 8：
--   · 2 不能表示为 {1} 的连续和（唯一和 1 ≠ 2）；
--   · 4 不能表示为 {1, 2} 的连续和（连续和 1、2、1+2=3 均 ≠ 4）；
--   · 8 不能表示为 {1, 2, 4} 的连续和（连续和 1、2、4、1+2=3、
--     2+4=6、1+2+4=7 均 ≠ 8）；
--   · 同时 5 = 1+4、6 = 2+4、7 = 1+2+4 确实可由连续和表示，
--     即 8 确为「第一个不可由连续和表示」的最小整数。
-- 全部闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp297.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp297 : (((((((1 ≠ 2) ∧ (1 ≠ 4)) ∧ ((2 ≠ 4) ∧ (1 + 2 ≠ 4))) ∧ (((1 ≠ 8) ∧ (2 ≠ 8)) ∧ ((4 ≠ 8) ∧ (1 + 2 ≠ 8)))) ∧ ((((2 + 4 ≠ 8) ∧ (1 + 2 + 4 ≠ 8)) ∧ ((1 + 4 = 5) ∧ (2 + 4 = 6))) ∧ (((1 + 2 + 4 = 7) ∧ (1 ≥ 1)) ∧ ((2 ≥ 1) ∧ ((4 ≥ 1) ∧ (8 ≥ 1))))))) ∧ True) := by decide
