-- =====================================================================
-- JSP-000299 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How large can a subset of a finite integer range be if none of
--       its subset sums equals a prescribed target?
--       （有限整数区间的子集，若其任何子集和都不等于指定目标，可多大？）
--
-- 例证：A = {2, 4, 6, 8, 10} 是 [1, 10] 的 5 元子集，指定目标 11：
-- 全部 31 个非空子集和均为偶数（元素全偶），故没有任何子集和等于
-- 奇数 11。全部 31 个子集和逐一枚举，闭项 by decide。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp299.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp299 : ((((2 ≥ 1 ∧ (2 ≤ 10 ∧ (2 % 2 = 0 ∧ (4 ≥ 1 ∧ (4 ≤ 10 ∧ (4 % 2 = 0 ∧ (6 ≥ 1 ∧ (6 ≤ 10 ∧ (6 % 2 = 0 ∧ (8 ≥ 1 ∧ (8 ≤ 10 ∧ (8 % 2 = 0 ∧ (10 ≥ 1 ∧ 10 ≤ 10)))))))))))))) ∧ (((10 % 2 = 0 ∧ (2 ≠ 4 ∧ (2 ≠ 6 ∧ (2 ≠ 8 ∧ (2 ≠ 10 ∧ (4 ≠ 6 ∧ (4 ≠ 8 ∧ (4 ≠ 10 ∧ (6 ≠ 8 ∧ (6 ≠ 10 ∧ (8 ≠ 10 ∧ (11 % 2 = 1 ∧ (2 ≠ 11 ∧ 4 ≠ 11)))))))))))))) ∧ (((6 ≠ 11 ∧ (6 ≠ 11 ∧ (8 ≠ 11 ∧ (10 ≠ 11 ∧ (12 ≠ 11 ∧ (8 ≠ 11 ∧ (10 ≠ 11 ∧ (12 ≠ 11 ∧ (14 ≠ 11 ∧ (14 ≠ 11 ∧ (16 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ 10 ≠ 11)))))))))))))) ∧ (((12 ≠ 11 ∧ (14 ≠ 11 ∧ (16 ≠ 11 ∧ (16 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ (22 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ (22 ≠ 11 ∧ (24 ≠ 11 ∧ (24 ≠ 11 ∧ (26 ≠ 11 ∧ 28 ≠ 11)))))))))))))) ∧ (30 ≠ 11 ∧ True)))))) := by
  have h0 : ((2 ≥ 1 ∧ (2 ≤ 10 ∧ (2 % 2 = 0 ∧ (4 ≥ 1 ∧ (4 ≤ 10 ∧ (4 % 2 = 0 ∧ (6 ≥ 1 ∧ (6 ≤ 10 ∧ (6 % 2 = 0 ∧ (8 ≥ 1 ∧ (8 ≤ 10 ∧ (8 % 2 = 0 ∧ (10 ≥ 1 ∧ 10 ≤ 10)))))))))))))) := by decide
  have h1 : ((10 % 2 = 0 ∧ (2 ≠ 4 ∧ (2 ≠ 6 ∧ (2 ≠ 8 ∧ (2 ≠ 10 ∧ (4 ≠ 6 ∧ (4 ≠ 8 ∧ (4 ≠ 10 ∧ (6 ≠ 8 ∧ (6 ≠ 10 ∧ (8 ≠ 10 ∧ (11 % 2 = 1 ∧ (2 ≠ 11 ∧ 4 ≠ 11)))))))))))))) := by decide
  have h2 : ((6 ≠ 11 ∧ (6 ≠ 11 ∧ (8 ≠ 11 ∧ (10 ≠ 11 ∧ (12 ≠ 11 ∧ (8 ≠ 11 ∧ (10 ≠ 11 ∧ (12 ≠ 11 ∧ (14 ≠ 11 ∧ (14 ≠ 11 ∧ (16 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ 10 ≠ 11)))))))))))))) := by decide
  have h3 : ((12 ≠ 11 ∧ (14 ≠ 11 ∧ (16 ≠ 11 ∧ (16 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ (22 ≠ 11 ∧ (18 ≠ 11 ∧ (20 ≠ 11 ∧ (22 ≠ 11 ∧ (24 ≠ 11 ∧ (24 ≠ 11 ∧ (26 ≠ 11 ∧ 28 ≠ 11)))))))))))))) := by decide
  have h4 : 30 ≠ 11 := by decide
  exact ⟨h0, ⟨h1, ⟨h2, ⟨h3, ⟨h4, True.intro⟩⟩⟩⟩⟩
