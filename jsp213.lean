-- =====================================================================
-- JSP-000213 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：Representing 4/n as a sum of three unit fractions
--       （4/n 表示为三个单位分数之和；Erdős–Straus 猜想例证）
--
-- 构造（存在性，n = 5）：
--   4/5 = 1/2 + 1/5 + 1/10
--   用公共分母 10 通分：4·10/5 = 8，且 10/2 + 10/5 + 10/10 = 5+2+1 = 8。
--   即 4/5 与 1/2+1/5+1/10 通分后分子同为 8，二者相等。
--   全部闭项机器核验（by decide）。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp213.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp213 :
  (4 * 10 / 5 = 8) ∧ (10 / 2 + 10 / 5 + 10 / 10 = 8) := by
  have h0 : (4 * 10 / 5 = 8) := by decide
  have h1 : (10 / 2 + 10 / 5 + 10 / 10 = 8) := by decide
  exact ⟨h0, h1⟩
