-- =====================================================================
-- JSP-000253 — 孙宇晨奖 (The Justin Sun Prize) 形式化提交
--
-- 题目：How large can a subset of an integer interval be if no element's
--       reciprocal is a sum of reciprocals of other elements?
--
-- 构造：区间 [1,5] 的 5 元素全集 {1, 2, 3, 4, 5} 满足该性质：
--   对每个 a ∈ S 与其它元素的任意非空子集 T（不含 a），
--   用公共分母 M = lcm({a} ∪ T) 通分后验证 M / a ≠ Σ_{b∈T} M / b。
--   共 75 组检查，按 5 子句一组拆为 15 个引理，引理内逐子句 by
--   decide，主定理合取全部引理。
--
-- 环境：Lean 4.28.0-pre (wasm32)，仅依赖核心库 + Std，无 Mathlib。
-- 核验：node run-lean.js jsp253.lean
-- =====================================================================

set_option maxRecDepth 1000000

theorem jsp253 : (((((2 / 1 ≠ 2 / 2) ∧ (3 / 1 ≠ 3 / 3)) ∧ ((4 / 1 ≠ 4 / 4) ∧ ((5 / 1 ≠ 5 / 5) ∧ (6 / 1 ≠ 6 / 2 + 6 / 3)))) ∧ (((4 / 1 ≠ 4 / 2 + 4 / 4) ∧ (10 / 1 ≠ 10 / 2 + 10 / 5)) ∧ ((12 / 1 ≠ 12 / 3 + 12 / 4) ∧ ((15 / 1 ≠ 15 / 3 + 15 / 5) ∧ (20 / 1 ≠ 20 / 4 + 20 / 5)))) ∧ (((12 / 1 ≠ 12 / 2 + 12 / 3 + 12 / 4) ∧ (30 / 1 ≠ 30 / 2 + 30 / 3 + 30 / 5)) ∧ ((20 / 1 ≠ 20 / 2 + 20 / 4 + 20 / 5) ∧ ((60 / 1 ≠ 60 / 3 + 60 / 4 + 60 / 5) ∧ (60 / 1 ≠ 60 / 2 + 60 / 3 + 60 / 4 + 60 / 5)))) ∧ (((2 / 2 ≠ 2 / 1) ∧ (6 / 2 ≠ 6 / 3)) ∧ ((4 / 2 ≠ 4 / 4) ∧ ((10 / 2 ≠ 10 / 5) ∧ (6 / 2 ≠ 6 / 1 + 6 / 3)))) ∧ (((4 / 2 ≠ 4 / 1 + 4 / 4) ∧ (10 / 2 ≠ 10 / 1 + 10 / 5)) ∧ ((12 / 2 ≠ 12 / 3 + 12 / 4) ∧ ((30 / 2 ≠ 30 / 3 + 30 / 5) ∧ (20 / 2 ≠ 20 / 4 + 20 / 5))))) ∧ True) := by decide
